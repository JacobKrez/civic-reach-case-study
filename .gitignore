.env
__pycache__/
*.pyc
.venv/
logs/
redteam/report_latest.json

# Internal build-loop tooling notes — reference the local Hermes/Mission
# Control setup (paths, agent identities) that only exists on the author's
# machine; not something a reviewer cloning this repo needs to see.
.hermes/

# Self-improvement queue script — hardcodes the author's local machine
# paths and a personal Mission Control DB that doesn't exist outside it;
# excluded so a fresh clone's test suite/file tree stay self-contained.
scripts/self_improve.py
tests/test_self_improve_idempotency.py

# Private planning notes — keep local, never publish
LOOP_PLAN.md
ROADMAP.md
CONVERSATION_OVERHAUL.md
SECURITY_AND_HARDENING.md
INTERVIEW_PREP.md
*.txt

# Review artifacts — keep local, never publish
PRODUCTION_READINESS_REVIEW.md
_review/

# Stray Mission Control DB handle created by tooling run from the repo cwd
mc.db

# Simulator/red-team run artifacts. The dated EVIDENCE reports referenced by
# EVALUATION.md are committed explicitly with `git add -f`; the per-run
# timestamped churn (dozens of files per night) is not repo content.
redteam/reports/simulator_*.json
redteam/reports/simulator_*.md
redteam/findings/*.json
redteam/failures_queue.jsonl
redteam/fixtures_subset/
redteam/findings/TOP.md
