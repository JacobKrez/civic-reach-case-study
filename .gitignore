# Editor/assistant local settings and project-local scratch config.
.claude/

# Local maintenance script — hardcodes machine-specific paths and a
# local scratch database that does not exist outside this machine;
# excluded so a fresh clone's test suite and file tree stay
# self-contained.
scripts/self_improve.py
tests/test_self_improve_idempotency.py

