# --- LLM provider: set exactly ONE key below, and name it in LLM_PROVIDER ---
# `bash setup.sh` (or setup.bat on Windows) fills this in interactively.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama runs a model on this machine and needs no account or key.
# Set LLM_PROVIDER=ollama and OLLAMA_HOST=local, then `ollama pull llama3.1`.
# Point OLLAMA_BASE_URL elsewhere if the server is not on the default port.
OLLAMA_HOST=
OLLAMA_BASE_URL=http://localhost:11434/v1

# One of: anthropic, openai, google, groq, openrouter, deepseek, minimax, ollama
LLM_PROVIDER=anthropic
# Optional: a second provider to retry once if the primary call fails.
# Ignored unless its key is also set and it differs from LLM_PROVIDER.
LLM_FALLBACK_PROVIDER=
# Optional: override the provider's default model.
LLM_MODEL=

# --- W17 case-worker handoff: OPTIONAL, demo-only email notification ---
# The on-screen / print-ready handoff summary works standalone with zero
# external dependencies. The email path is best-effort and fires ONLY if
# ALL four vars below are set; otherwise it is silently skipped. Never
# point these at a real government/agency address — this demonstrates the
# notification mechanism only. SMTP_TO is read from env only, never
# hardcoded.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_TO=
